# Flightbase의 워커 설정 > 환경 변수에 같은 이름으로 등록합니다.
# 실제 비밀값을 이 파일에 저장하거나 이미지에 포함하지 마세요.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_REFERER=https://replace-with-public-url.example
APP_BASIC_AUTH_USER=reviewer
APP_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
DATA_DIR=/app/data
MAX_REQUEST_BYTES=134217728
HOST=0.0.0.0
PORT=8001
